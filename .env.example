NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only bearer for the existing once-per-minute Vercel Cron route.
# Use at least 16 random characters; never prefix this variable with NEXT_PUBLIC_.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
FORM_INTAKE_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Standard Z.AI Open Platform key only; do not use a GLM Coding Plan key here.
ZAI_API_KEY=
TEMPLATE_COPILOT_PROVIDER=
TEMPLATE_COPILOT_MODEL=
# Server-only v2 rollout gates. Keep all false by default.
# 1. TEMPLATE_COPILOT_V2 enables the governed v2 interview.
# 2. TEMPLATE_COPILOT_V2_STEP4 enables optional guided answer controls for v2.1.
#    Keep it false to fall back to plain typed input without changing saved answers.
# 3. EXTRACTION_SHADOW permits provider extraction without creating candidates.
# 4. CANDIDATE_CREATION requires EXTRACTION_SHADOW=true and reviewed qualification.
# Kill switch: set CANDIDATE_CREATION=false to stop new candidate writes without
# disabling the manual v2 interview or deleting queued work. The scheduled
# extraction drain is enabled only while all three gates below permit it.
# Set EXTRACTION_SHADOW=false to stop provider calls.
TEMPLATE_COPILOT_V2=false
TEMPLATE_COPILOT_V2_STEP4=false
TEMPLATE_COPILOT_V2_STEP5_EDITING=false
# Step 6 entry modes are default-off server kill switches. Guided gates new v2
# interviews and Guided answers; the other flags independently gate their own
# intake actions. Disabling any flag keeps existing sessions/snapshots readable.
TEMPLATE_COPILOT_V2_GUIDED=false
TEMPLATE_COPILOT_V2_DESCRIBE_EVERYTHING=false
TEMPLATE_COPILOT_V2_SIMILAR_TEMPLATE=false
# Step 7 purpose-built editors are separately default-off. Disabling one keeps
# its canonical setting visible but read-only.
TEMPLATE_COPILOT_V2_ATTACHMENT_EDITOR=false
TEMPLATE_COPILOT_V2_CONDITION_EDITOR=false
TEMPLATE_COPILOT_V2_NOTIFICATION_EDITOR=false
# Public build-time Step 8 qualification switch. Keep false in Development and
# Production. Set true only on the authorized isolated Preview branch while
# running the authenticated v2.2 language/accessibility gate.
NEXT_PUBLIC_TEMPLATE_COPILOT_V2_STEP8_QUALIFICATION=false
TEMPLATE_COPILOT_V2_EXTRACTION_SHADOW=false
TEMPLATE_COPILOT_V2_CANDIDATE_CREATION=false
TEMPLATE_COPILOT_OPENROUTER_ZDR=false
TEMPLATE_COPILOT_OPENROUTER_REASONING_EFFORT=none
TEMPLATE_COPILOT_ALLOW_NON_ZDR_PRODUCTION=false
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_VISION_OCR_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_PDF_ENGINE=mistral-ocr
NEXT_PUBLIC_PDF_OCR_MODE=qwen-page-images
OPENROUTER_SITE_URL=https://approval-app-three.vercel.app
OPENROUTER_APP_TITLE=Approval App
EMAIL_PROVIDER=resend
EMAIL_LIVE=false
EMAIL_FROM="Approval App <onboarding@resend.dev>"
EMAIL_TEST_REDIRECT_TO=
RESEND_API_KEY=
