{
  "name": "approval-app",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.10"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "deploy:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-preview.ps1",
    "release:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-production.ps1",
    "perf:pages": "node scripts/measure-page-load.mjs",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types \"src/**/*.test.mjs\"",
    "test:db:authoritative": "node scripts/test-authoritative-db.mjs",
    "test:api:authoritative": "node scripts/test-authoritative-api.mjs",
    "test:db:concurrency": "node scripts/test-authoritative-concurrency.mjs",
    "test:db:lock-timeout": "node scripts/test-authoritative-lock-timeout.mjs",
    "test:e2e:two-browser": "node scripts/test-authoritative-two-browser.mjs",
    "test:e2e:collaboration": "node scripts/test-authoritative-collaboration-browser.mjs",
    "test:e2e:template-copilot-preview": "node scripts/test-template-copilot-preview.mjs",
    "test:e2e:template-copilot-cross-user": "node scripts/test-template-copilot-cross-user.mjs",
    "test:e2e:template-copilot-qualification": "node scripts/test-template-copilot-qualification.mjs",
    "test:e2e:template-copilot-v2-step4": "node scripts/test-template-copilot-v2-step4-browser.mjs",
    "test:e2e:template-copilot-v2-step5": "node scripts/test-template-copilot-v2-step5-browser.mjs",
    "test:template-copilot-v2-extraction-qualification": "node scripts/test-template-copilot-v2-extraction-qualification.mjs",
    "test:template-copilot-v2-step3-qualification": "node scripts/test-template-copilot-v2-step3-qualification.mjs",
    "test:openrouter:copilot-model": "node scripts/test-openrouter-copilot-model.mjs",
    "test:db:durable-operations": "node scripts/test-durable-operations.mjs",
    "test:api:durable-operations": "node scripts/test-durable-operations-api.mjs",
    "test:security:phase7": "node scripts/test-phase7-security.mjs",
    "test:load:phase7": "node scripts/test-phase7-load.mjs",
    "test:a11y:phase7": "node scripts/test-phase7-accessibility.mjs",
    "test:restore:phase7": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-phase7-backup-restore.ps1",
    "test:db:phase8-seed": "node scripts/test-phase8-migration-cutover.mjs seed",
    "test:db:phase8-verify": "node scripts/test-phase8-migration-cutover.mjs verify",
    "test:api:phase8-rollback": "node scripts/test-phase8-rollback-api.mjs",
    "test:db:migration-seed": "node scripts/test-authoritative-migration-backfill.mjs seed",
    "test:db:migration-verify": "node scripts/test-authoritative-migration-backfill.mjs verify",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "e2e:drafts": "node scripts/e2e-drafts-smoke.mjs",
    "e2e:regression": "node scripts/e2e-regression.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@xyflow/react": "^12.11.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "openai": "^6.42.0",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fflate": "^0.8.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
